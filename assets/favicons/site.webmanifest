---
# Liquid 처리용 front matter — theme/background 색의 정본은 _data/brand.yml
# (이중 SoT 감사 [6], 2026-07-22. 예전엔 hex 가 여기 하드코딩)
---
{
    "name": "Blackbox",
    "short_name": "Blackbox",
    "icons": [
        {
            "src": "/assets/favicons/android-chrome-192x192.png",
            "sizes": "192x192",
            "type": "image/png"
        },
        {
            "src": "/assets/favicons/android-chrome-512x512.png",
            "sizes": "512x512",
            "type": "image/png"
        }
    ],
    "theme_color": "{{ site.data.brand.navy }}",
    "background_color": "{{ site.data.brand.navy }}",
    "display": "standalone"
}
